{
  "manifest_version": 3,
  "name": "Inspector's Notebook listener",
  "short_name": "Inspector",
  "version": "0.1.0",
  "description": "Listens in security consoles for the Inspector's Notebook desktop app. Nothing is captured unless the app is open.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://security.microsoft.com/*",
    "https://portal.azure.com/*",
    "https://*.reactblade.portal.azure.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "vendor/browser-polyfill.min.js",
      "time.js",
      "entities.js",
      "parsers/registry.js",
      "parsers/defender.js",
      "parsers/sentinel.js",
      "consoles.js",
      "icon.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://security.microsoft.com/*",
        "https://portal.azure.com/*",
        "https://*.reactblade.portal.azure.net/*"
      ],
      "js": [
        "time.js",
        "entities.js",
        "parsers/registry.js",
        "parsers/defender.js",
        "parsers/sentinel.js",
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://security.microsoft.com/*",
        "https://portal.azure.com/*",
        "https://*.reactblade.portal.azure.net/*"
      ],
      "js": [
        "vendor/browser-polyfill.min.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Inspector: app closed",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{52724e34-54e6-4e08-bebb-ad98a8877daa}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
